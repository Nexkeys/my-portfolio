---
import Base from '../../layouts/Base.astro';
import { getNotes } from '../../lib/content';
const notes = await getNotes();
---
<Base title="Notes" description="Notes on building software, shipping products and engineering from Lagos by Ernest Uwaoma." noindex={notes.length === 0}>
  <section class="wrap head">
    <p class="mono eyebrow">Notes · {notes.length}</p>
    <h1 class="title" data-reveal>Notes and <em>writing</em></h1>
  </section>
  <section class="wrap list" aria-label="All notes">
    {notes.length === 0 ? (
      <p class="empty">Nothing published here yet.</p>
    ) : (
      <ul role="list">
        {notes.map((n) => (
          <li data-reveal>
            <a href={`/notes/${n.slug}`} class="row">
              <time class="mono" datetime={n.date ?? ''}>{n.date}</time>
              <span class="t">{n.title}</span>
              <span class="ex">{n.excerpt}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
<style>
  .head {
    padding-top: clamp(130px, 18vw, 200px);
    padding-bottom: 48px;
  }
  .title {
    font-size: clamp(56px, 10vw, 160px);
    font-weight: 600;
    letter-spacing: -0.058em;
    line-height: 0.88;
  }
  .list {
    padding-bottom: 120px;
  }
  .row {
    display: grid;
    grid-template-columns: 140px 1fr 1.2fr;
    gap: 24px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }
  .t {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .row:hover .t {
    color: var(--accent);
  }
  .ex,
  .empty {
    color: var(--mute);
  }
  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
