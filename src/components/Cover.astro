---
/**
 * Project artwork. Uses the uploaded cover when there is one,
 * otherwise draws a quiet generative pattern seeded by the slug.
 */
interface Props {
  slug: string;
  title: string;
  category?: string | null;
  image?: string | null;
  class?: string;
  eager?: boolean;
}
const { slug, title, category, image, class: cls = '', eager = false } = Astro.props;

let seed = 0;
for (const ch of slug) seed = (seed * 31 + ch.charCodeAt(0)) >>> 0;
const rand = () => {
  seed = (seed * 1664525 + 1013904223) >>> 0;
  return seed / 4294967296;
};
const kind = seed % 4;
const W = 1600;
const H = 1000;
const ink = '#f2f0eb';
const accent = '#ff5a1f';

type Shape = { d?: string; cx?: number; cy?: number; r?: number; x1?: number; y1?: number; x2?: number; y2?: number; o: number; a?: boolean; w?: number };
const shapes: Shape[] = [];

if (kind === 0) {
  const cx = 900 + rand() * 400;
  const cy = 300 + rand() * 300;
  for (let i = 1; i < 16; i++) shapes.push({ cx, cy, r: i * 58, o: 0.05 + (i % 4 === 0 ? 0.12 : 0.04), w: 1.4 });
  shapes.push({ cx, cy, r: 14, o: 1, a: true });
} else if (kind === 1) {
  const step = 64;
  const tilt = 0.3 + rand() * 0.5;
  for (let x = step; x < W; x += step)
    for (let y = step; y < H; y += step) {
      const on = Math.abs(y - (H - x * tilt)) < step * 0.6;
      shapes.push({ cx: x, cy: y, r: on ? 6 : 2.2, o: on ? 1 : 0.18, a: on });
    }
} else if (kind === 2) {
  let y = 140;
  while (y < H - 340) {
    const indent = Math.floor(rand() * 4) * 70;
    const len = 200 + rand() * 900;
    const hot = rand() > 0.9;
    shapes.push({ x1: 180 + indent, y1: y, x2: 180 + indent + len, y2: y, o: hot ? 1 : 0.16, a: hot, w: 14 });
    y += 46;
  }
} else {
  const r = 520 + rand() * 200;
  for (let i = 0; i < 9; i++) shapes.push({ d: `M ${W - 120 - i * 70} ${H} A ${r - i * 40} ${r - i * 40} 0 0 0 ${W - 120 - i * 70 - 2 * (r - i * 40)} ${H}`, o: i === 3 ? 1 : 0.12, a: i === 3, w: 2 });
  for (let x = 0; x <= W; x += 100) shapes.push({ x1: x, y1: 0, x2: x, y2: H, o: 0.04, w: 1 });
}
const label = (category || '').toUpperCase();
---
<figure class={`cover ${cls}`}>
  {image ? (
    <img src={image} alt={`${title} screenshot`} width="1600" height="1000" loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${title} cover`} preserveAspectRatio="xMidYMid slice">
      <rect width={W} height={H} fill="#141415" />
      {shapes.map((s) =>
        s.d ? (
          <path d={s.d} fill="none" stroke={s.a ? accent : ink} stroke-opacity={s.o} stroke-width={s.w} />
        ) : s.r !== undefined && s.w ? (
          <circle cx={s.cx} cy={s.cy} r={s.r} fill="none" stroke={ink} stroke-opacity={s.o} stroke-width={s.w} />
        ) : s.r !== undefined ? (
          <circle cx={s.cx} cy={s.cy} r={s.r} fill={s.a ? accent : ink} fill-opacity={s.a ? 1 : s.o} />
        ) : (
          <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke={s.a ? accent : ink} stroke-opacity={s.o} stroke-width={s.w} stroke-linecap="round" />
        )
      )}
      <defs>
        <linearGradient id={`fade-${slug}`} x1="0" y1="1" x2="0" y2="0">
          <stop offset="0" stop-color="#141415" stop-opacity="0.96" />
          <stop offset="0.38" stop-color="#141415" stop-opacity="0.75" />
          <stop offset="0.6" stop-color="#141415" stop-opacity="0" />
        </linearGradient>
      </defs>
      <rect width={W} height={H} fill={`url(#fade-${slug})`} />
      <text x="80" y="110" fill={ink} fill-opacity="0.5" font-family="JetBrains Mono Variable, monospace" font-size="30" letter-spacing="2">{label}</text>
      <text x="76" y={H - 90} fill={ink} font-family="Instrument Serif, serif" font-size="150" letter-spacing="-3">{title}</text>
    </svg>
  )}
</figure>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    background: #141415;
    aspect-ratio: 16 / 10;
    border-radius: 14px;
  }
  .cover :global(svg),
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
